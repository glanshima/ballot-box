# Neon POOLED connection string (host contains "-pooler")
DATABASE_URL=

# Used only by the integration tests: a separate Neon branch/database. Never point this at production.
TEST_DATABASE_URL=

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET=

# Super admin (single seeded account). Generate the hash with:
#   npm run hash-password -- "your password"
# IMPORTANT: bcrypt hashes contain "$". In .env files escape each one as "\$"
# (the hash-password script prints the escaped form). In the Vercel dashboard paste it unescaped.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Public base URL used in invitation links, e.g. https://your-app.vercel.app (no trailing slash)
APP_URL=http://localhost:3000

# Resend (email). EMAIL_FROM must be a verified sender, e.g. "Club Elections <vote@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# Upstash Redis (rate limiting). Leave blank locally: limiting is disabled with a console warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (image uploads)
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/close-elections. Vercel sends it as "Authorization: Bearer <value>"
CRON_SECRET=
