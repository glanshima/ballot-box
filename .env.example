# Neon POOLED connection string (host contains "-pooler")
DATABASE_URL=

# Used only by the integration tests: a separate Neon branch/database. Never point this at production.
TEST_DATABASE_URL=

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET=

# Bootstrap only: `npm run db:bootstrap` seeds the first super admin from these and then
# they are never read again. Further super admins are created in /admin/admins.
# Generate the hash with: npm run hash-password -- "your password"
# IMPORTANT: bcrypt hashes contain "$". In .env files escape each one as "\$"
# (the hash-password script prints the escaped form). In the Vercel dashboard paste it unescaped.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Public base URL used in invitation links, e.g. https://your-app.vercel.app (no trailing slash)
APP_URL=http://localhost:3000

# Resend (email). EMAIL_FROM must be on a verified domain, e.g. "Ballot Box <no-reply@ballotbox.sidgakstech.me>"
# Verify with: npm run email:test -- you@example.com
RESEND_API_KEY=
EMAIL_FROM=

# Upstash Redis (rate limiting). Leave blank locally: limiting is disabled with a console warning.
# The Vercel Marketplace integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (image uploads)
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/close-elections. Vercel sends it as "Authorization: Bearer <value>"
CRON_SECRET=
